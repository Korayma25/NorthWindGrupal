<EditForm Model="ViewModel" OnValidSubmit="ViewModel.Register">
<ModelValidator Validator="ViewModel.Validator" @ref="ViewModel.ModelValidatorComponentReference" />
<ValidationSummary />
<div class="form-group"><label for="FirstName">Nombre</label><input type="text" id="FirstName" class="form-control" @bind:get="ViewModel.FirstName" @bind:set="OnFirstNameInput" @bind:event="oninput" /><ValidationMessage For="@(()=>ViewModel.FirstName)" /></div>
<div class="form-group"><label for="LastName">Apellidos</label><input type="text" id="LastName" class="form-control" @bind:get="ViewModel.LastName" @bind:set="OnLastNameInput" @bind:event="oninput" /><ValidationMessage For="@(()=>ViewModel.LastName)" /></div>
<div class="form-group"><label for="Email">Correo</label><input type="text" id="Email" class="form-control" @bind:get="ViewModel.Email" @bind:set="OnEmailInput" @bind:event="oninput" /><ValidationMessage For="@(()=>ViewModel.Email)" /></div>
<div class="form-group"><label for="Password">Contraseña</label><InputText id="Password" class="form-control" type="password" @bind-Value="ViewModel.Password" /><ValidationMessage For="@(()=>ViewModel.Password)" /></div>
<div class="form-group"><label for="PasswordConfirmation">Confirmar contraseña</label><InputText id="PasswordConfirmation" class="form-control" type="password" @bind-Value="ViewModel.PasswordConfirmation" /><ValidationMessage For="@(()=>ViewModel.PasswordConfirmation)" /></div>
<button class="btn btn-primary mt-3">Registrar</button>
</EditForm>
@if (!string.IsNullOrWhiteSpace(ViewModel.InformationMessage)) { <div class="alert alert-info mt-3">@ViewModel.InformationMessage</div> }
@code {
    [Parameter, EditorRequired]
    public UserRegistrationViewModel ViewModel { get; set; } = default!;

    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    private void OnFirstNameInput(string? value)
    {
        ViewModel.FirstName = MembershipTextRules.KeepLetters(value);
        EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => ViewModel.FirstName));
    }

    private void OnLastNameInput(string? value)
    {
        ViewModel.LastName = MembershipTextRules.KeepLetters(value);
        EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => ViewModel.LastName));
    }

    private void OnEmailInput(string? value)
    {
        ViewModel.Email = MembershipTextRules.KeepLoginCharacters(value);
        EditContext?.NotifyFieldChanged(FieldIdentifier.Create(() => ViewModel.Email));
    }
}

