@namespace NorthWind.RazorComponents.Clock
@implements IAsyncDisposable

<div class="nw-clock" aria-label="Fecha y hora actual">
    <div class="nw-clock-icon-wrapper" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
            <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
        </svg>
    </div>
    <time datetime="@_currentTime.ToString("yyyy-MM-ddTHH:mm:ss")" class="nw-clock-details">
        <span class="nw-clock-date d-none d-md-block">@FormattedDate</span>
        <span class="nw-clock-time">@FormattedTime</span>
    </time>
</div>

@code {
    private DateTime _currentTime = DateTime.Now;
    private CancellationTokenSource? _cts;
    private Task? _timerTask;

    private static readonly string[] DayNames =
    [
        "domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"
    ];

    private static readonly string[] MonthNames =
    [
        "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
    ];

    private string FormattedDate =>
        $"{DayNames[(int)_currentTime.DayOfWeek]}, {_currentTime.Day} de {MonthNames[_currentTime.Month - 1]} de {_currentTime.Year}";

    private string FormattedTime =>
        _currentTime.ToString("HH:mm:ss");

    protected override void OnInitialized()
    {
        _currentTime = DateTime.Now;
        _cts = new CancellationTokenSource();
        _timerTask = StartClockAsync(_cts.Token);
    }

    private async Task StartClockAsync(CancellationToken cancellationToken)
    {
        try
        {
            // Align with the start of the next second to prevent desync
            int msToNextSecond = 1000 - DateTime.Now.Millisecond;
            if (msToNextSecond > 0)
            {
                await Task.Delay(msToNextSecond, cancellationToken);
            }

            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (!cancellationToken.IsCancellationRequested)
            {
                _currentTime = DateTime.Now;
                if (!cancellationToken.IsCancellationRequested)
                {
                    try
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                    catch (ObjectDisposedException)
                    {
                        break;
                    }
                }
                await timer.WaitForNextTickAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected cancellation during component disposal
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            _cts.Cancel();
            if (_timerTask is not null)
            {
                try
                {
                    await _timerTask;
                }
                catch (OperationCanceledException)
                {
                }
            }
            _cts.Dispose();
            _cts = null;
        }
    }
}
