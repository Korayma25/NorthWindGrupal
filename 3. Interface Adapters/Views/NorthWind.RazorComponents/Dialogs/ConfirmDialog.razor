@namespace NorthWind.RazorComponents.Dialogs

@if (Visible)
{
    <div class="modal d-block fade show"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@TitleId"
         style="background-color: rgba(11, 15, 26, 0.75);"
         @onkeydown="HandleKeyDown"
         @onclick="CancelAsync">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content shadow border-0">
                <div class="modal-header">
                    <h5 class="modal-title" id="@TitleId">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAsync"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@Message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" autofocus @onclick="CancelAsync">
                        @CancelText
                    </button>
                    <button type="button" class="btn nw-confirm-btn nw-confirm-btn-danger" @onclick="ConfirmAsync">
                        @ConfirmText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string ConfirmText { get; set; } = "Aceptar";

    [Parameter]
    public string CancelText { get; set; } = "Cancelar";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private readonly string TitleId = $"confirm-dialog-title-{Guid.NewGuid():N}";

    private async Task CancelAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }

    private async Task ConfirmAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnConfirm.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CancelAsync();
        }
    }
}
